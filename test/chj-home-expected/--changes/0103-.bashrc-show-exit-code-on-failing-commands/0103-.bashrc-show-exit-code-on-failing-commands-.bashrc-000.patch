From ebd6f9a9b7f076972f4ff6c5c2cef7a95a511c1e Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 15 Jun 2021 04:11:44 +0100
Subject: .bashrc 000: [PATCH 103/191] .bashrc: show exit code on failing commands

---
 .bashrc | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -17,6 +17,15 @@ shopt -s checkwinsize
 # make less more friendly for non-text input files, see lesspipe(1)
 [ -x /usr/bin/lesspipe ] && eval "$(lesspipe)"
 
+__ps1_show_exitcode () {
+    local v=$?
+    if [ "$v" -ne 0 ]; then
+	echo -ne "$v "'\033[01;41m';
+    else
+	echo -ne '\033[01;32m';
+    fi
+}
+
 # set a fancy prompt (non-color, unless we know we "want" color)
 case "$TERM" in
 xterm-color|xterm)

From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 24 Jul 2022 13:14:18 +0100
Subject: .bashrc 002: [PATCH 151/191] .bashrc: cgd*: accept index argument

---
 .bashrc | 61 +++++++++++++++++++++++++++++++++++++++++++++++----------
 1 file changed, 51 insertions(+), 10 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -179,4 +199,6 @@ cdnnn () {
     if [ -n "$res" ]; then
-        if [ "$(printf '%s' "$res" | wc -l)" -eq 0 ]; then
+        local len
+        len0="$(printf '%s' "$res" | wc -l)"
+        if [ "$len0" -eq 0 ]; then
             cd "$res"
         else

Subject: home-init 003: [PATCH 039/191] ask user-specific info from home-init, generate files

---
 .bash_profile |  7 +++---
 .gitconfig    | 20 -----------------
 home-init     | 61 +++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 60 insertions(+), 28 deletions(-)
 delete mode 100644 .gitconfig

diff --git a/home-init b/home-init
--- a/home-init
+++ b/home-init
@@ -12,4 +55,13 @@ set -euo pipefail
 
+#[gpg]
+#	program = gpg+scrypt
+
+#[push]
+#	default = simple
+# old git can*not* deal with this
+EOF
+
+set +eu
 set -x
 
 ln -s /opt/chj/emacs/.emacs

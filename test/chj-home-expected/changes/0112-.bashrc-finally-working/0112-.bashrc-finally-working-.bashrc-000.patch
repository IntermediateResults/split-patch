From cb9e5d8c0b5c746a096cfbc81fe97c44153040b4 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 15 Jun 2021 13:29:11 +0100
Subject: .bashrc 000: [PATCH 112/191] .bashrc: finally working

---
 .bashrc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -20,5 +20,9 @@ shopt -s checkwinsize
 __ps1_show_exitcode () {
     local exitcode=$?
     if [ "$exitcode" -ne 0 ]; then
-	echo -n '\[\033[01;41m\]'"$exitcode"'\[\033[00m \033[01;32m\]';
+	echo -ne '\001\033[01;41m\002'
+	echo -n "$exitcode"
+	echo -ne '\001\033[00m\002'
+	echo -n ' '
+	echo -ne '\001\033[01;32m\002'
     else

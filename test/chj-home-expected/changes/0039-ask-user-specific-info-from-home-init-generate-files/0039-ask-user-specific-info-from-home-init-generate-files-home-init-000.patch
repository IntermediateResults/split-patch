From 47f896faa205419bee6e91c7d8d539199d825afa Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 26 Nov 2017 01:04:27 +0000
Subject: home-init 000: [PATCH 039/191] ask user-specific info from home-init, generate files

---
 .bash_profile |  7 +++---
 .gitconfig    | 20 -----------------
 home-init     | 61 +++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 60 insertions(+), 28 deletions(-)
 delete mode 100644 .gitconfig

diff --git a/home-init b/home-init
--- a/home-init
+++ b/home-init
@@ -4,7 +4,20 @@ set -euo pipefail
 IFS=
 
 if [ "$(readlink -f .)" != "$(readlink -f ~)" ]; then
-    if [ "$(readlink -f .)" != "$(readlink -f "$(dirname "$0")")" ]; then
-	echo "$0: must be run from home dir or from $(dirname "$0"). Terminating."
-	exit 1
+    echo "$0: must be run from home dir. Terminating."
+    exit 1
+fi
+
+
+cancel() {
+    echo "$0: cancelled due to missing answer."
+    exit 1
+}
+
+if read -e -p "Please enter your full name: " fullname; then
+    if read -e -p "Please enter your (bare) email address: " email; then
+	echo "$fullname" > .chj-home_fullname
+	echo "$email" > .chj-home_email
+    else
+	cancel
     fi

From 5f3e5d12d5c8574ef23f747b799a02a83014e397 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Mon, 12 Jun 2023 15:51:01 +0200
Subject: .chj-home/init 003: [PATCH 162/191] init: clone chj-emacs per user now

Not running make in chj-emacs automatically because it retrieves quite
a large amount of things that not every user may need.
---
 .chj-home/init | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/.chj-home/init b/.chj-home/init
--- a/.chj-home/init
+++ b/.chj-home/init
@@ -147,4 +148,8 @@ touch .ssh/authorized_keys
 
 set +x
 
-echo "NOTE: Your answers have been written to .chj-home_fullname, .chj-home_email, and the files .bash_profile_local and .gitconfig have been generated."
+echo "NOTE: Your answers have been written to .chj-home_fullname, .chj-home_email,"
+echo "      and the files .bash_profile_local and .gitconfig have been generated."
+echo "NOTE: Run 'cd .chj-emacs && make' if you want to use the full set of emacs"
+echo "      functionality now."
+

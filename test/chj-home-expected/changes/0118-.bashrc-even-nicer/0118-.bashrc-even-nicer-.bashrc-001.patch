From 407ebfc61eb3e6429065c4afe7cb36716e29ce55 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 22 Jun 2021 23:21:02 +0100
Subject: .bashrc 001: [PATCH 118/191] .bashrc: even nicer

---
 .bashrc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -27,7 +27,11 @@ __ps1_show_exitcode () {
 	echo -n ' '
 	echo -ne '\001\033[01;32m\002'
     else
-	echo -ne '  0 \001\033[01;32m\002'
+	echo -ne '\001\033[01;42m\002'
+	echo -n '  0'
+	echo -ne '\001\033[00m\002'
+	echo -n ' '
+	echo -ne '\001\033[01;32m\002'
     fi
 }
 

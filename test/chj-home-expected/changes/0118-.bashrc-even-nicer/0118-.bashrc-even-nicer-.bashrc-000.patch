From 407ebfc61eb3e6429065c4afe7cb36716e29ce55 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 22 Jun 2021 23:21:02 +0100
Subject: .bashrc 000: [PATCH 118/191] .bashrc: even nicer

---
 .bashrc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -23,7 +23,7 @@ __ps1_show_exitcode () {
     # and for this have to use \001 \002 over \[ \] .
     # (Also see https://mywiki.wooledge.org/BashFAQ/053 .)
     if [ "$exitcode" -ne 0 ]; then
-	echo -ne '\001\033[01;43m\002'
+	echo -ne '\001\033[01;45m\002'
 	printf '%3d' "$exitcode"
 	echo -ne '\001\033[00m\002'
 	echo -n ' '

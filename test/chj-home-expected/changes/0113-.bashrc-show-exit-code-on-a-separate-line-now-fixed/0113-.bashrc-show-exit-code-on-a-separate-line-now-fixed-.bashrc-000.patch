From 7b75a9e504fc49d716f3dc61ceb6895776a56b2c Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 15 Jun 2021 13:30:15 +0100
Subject: .bashrc 000: [PATCH 113/191] .bashrc: show exit code on a separate line (now
 fixed)

---
 .bashrc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -23,7 +23,7 @@ __ps1_show_exitcode () {
 	echo -ne '\001\033[01;41m\002'
 	echo -n "$exitcode"
 	echo -ne '\001\033[00m\002'
-	echo -n ' '
+	echo -ne '\n'
 	echo -ne '\001\033[01;32m\002'
     else
 	echo -ne '\001\033[01;32m\002'

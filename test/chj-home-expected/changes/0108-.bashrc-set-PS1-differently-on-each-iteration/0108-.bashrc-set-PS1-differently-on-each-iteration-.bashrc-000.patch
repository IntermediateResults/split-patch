From 1100a538cbdcdbf5079d43d63599341aba4ce51a Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Tue, 15 Jun 2021 12:58:50 +0100
Subject: .bashrc 000: [PATCH 108/191] .bashrc: set PS1 differently on each iteration

---
 .bashrc | 30 ++++++++++++++++--------------
 1 file changed, 16 insertions(+), 14 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -18,9 +18,9 @@ shopt -s checkwinsize
 [ -x /usr/bin/lesspipe ] && eval "$(lesspipe)"
 
 __ps1_show_exitcode () {
-    local v=$?
-    if [ "$v" -ne 0 ]; then
-	echo -ne '\033[01;41m'"$v"'\033[00m \033[01;32m';
+    #local exitcode=$?
+    if [ "$exitcode" -ne 0 ]; then
+	echo -ne '\033[01;41m'"$exitcode"'\033[00m \033[01;32m';
     else
 	echo -ne '\033[01;32m';
     fi

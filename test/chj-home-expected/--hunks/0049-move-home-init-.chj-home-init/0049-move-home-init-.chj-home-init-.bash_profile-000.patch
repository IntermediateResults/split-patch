From fa002c681dd12a2470fdfc7dab629e39c59950ea Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Fri, 1 Dec 2017 10:40:35 +0000
Subject: .bash_profile 000: [PATCH 049/191] move home-init -> .chj-home/init

---
 .bash_profile               | 2 +-
 home-init => .chj-home/init | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)
 rename home-init => .chj-home/init (93%)

diff --git a/.bash_profile b/.bash_profile
--- a/.bash_profile
+++ b/.bash_profile
@@ -48,7 +48,7 @@ ulimit -S -v 3200000  # note: can override in .bash_profile_local
 if [ -f ~/.bash_profile_local ]; then
     source ~/.bash_profile_local
 else
-    echo "NOTE: ~/.bash_profile_local does not exist, please run ~/home-init" >&2
+    echo "NOTE: ~/.bash_profile_local does not exist, please run ~/.chj-home/init" >&2
 fi
 if [ -f ~/.bashrc ]; then
     source ~/.bashrc

From 820eed1d431ae02c46acf826ff3da09927d05f58 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sat, 25 Nov 2017 18:06:41 +0000
Subject: .bash_profile 001: [PATCH 021/191] load .bashrc last

---
 .bash_profile | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/.bash_profile b/.bash_profile
--- a/.bash_profile
+++ b/.bash_profile
@@ -40,3 +35,9 @@ unset LESSOPEN
 unset LESSCLOSE
 
 export LANG=en_GB.UTF-8
+
+
+# include .bashrc if it exists
+if [ -f ~/.bashrc ]; then
+    . ~/.bashrc
+fi

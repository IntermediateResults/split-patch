Subject: .bashrc 001: [PATCH 026/191] cleanup

---
 .bashrc | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -86,7 +86,7 @@ mvcd() {
         if [ -d "${!#}" ]; then
             mv "$@" && cd "${!#}"
         else
-            #echo Last argument is not a directory
+            # echo Last argument is not a directory
             if [ "$#" -eq 2 ]; then
                 if [ -d "$1" ]; then
                     mv "$@" && cd "${!#}"

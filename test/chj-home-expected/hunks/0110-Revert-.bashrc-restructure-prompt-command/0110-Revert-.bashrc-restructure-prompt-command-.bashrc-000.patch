 .bashrc | 22 +++++++++-------------
 1 file changed, 9 insertions(+), 13 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -26,19 +26,6 @@ __ps1_show_exitcode () {
     fi
 }
 
-__prompt_command () {

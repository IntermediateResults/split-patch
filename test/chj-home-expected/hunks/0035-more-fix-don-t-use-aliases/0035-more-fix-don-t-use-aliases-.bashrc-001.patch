From 532932636c1a56ba1554ceeb3e736f463fe78a75 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sat, 25 Nov 2017 22:59:50 +0000
Subject: .bashrc 001: [PATCH 035/191] more fix "don't use aliases"

---
 .bashrc | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -127,9 +127,9 @@ cs() {
 find() { my.find "$@"; }
 df() { my.df "$@"; }
 
-mv() { mv -i "$@"; }
-cp() { cp -i "$@"; }
-#rm() { rm -i "$@"; }
+mv() { command mv -i "$@"; }
+cp() { command cp -i "$@"; }
+#rm() { command rm -i "$@"; }
 
 rens () {
     cd scratch/

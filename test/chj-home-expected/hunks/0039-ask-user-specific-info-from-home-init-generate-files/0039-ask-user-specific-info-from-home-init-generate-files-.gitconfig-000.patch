From 47f896faa205419bee6e91c7d8d539199d825afa Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 26 Nov 2017 01:04:27 +0000
Subject: .gitconfig 000: [PATCH 039/191] ask user-specific info from home-init, generate files

---
 .bash_profile |  7 +++---
 .gitconfig    | 20 -----------------
 home-init     | 61 +++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 60 insertions(+), 28 deletions(-)
 delete mode 100644 .gitconfig

diff --git a/.gitconfig b/.gitconfig
deleted file mode 100644
--- a/.gitconfig
+++ /dev/null
@@ -1,20 +0,0 @@
-[user]
-	email = ch@christianjaeger.ch
-	name = Christian Jaeger
-
-[diff "cj"]
-	command = _cj-git-tkdiff
-
-[merge]
-	conflictstyle = diff3
-	#renameLimit = 2000
-
-[core]
-	excludesfile = ~/.gitignore_global
-
-#[gpg]
-#	program = gpg+scrypt
-
-#[push]
-#	default = simple
-# old git can*not* deal with this

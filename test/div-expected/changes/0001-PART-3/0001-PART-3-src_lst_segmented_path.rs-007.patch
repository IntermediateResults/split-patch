 src/lst/possibly_segmented_path.rs |  46 +++---
 src/lst/segmented_path.rs          | 216 +++++++++++++++++++++++++----
 7 files changed, 483 insertions(+), 190 deletions(-)
 create mode 100644 src/kitschcell.rs


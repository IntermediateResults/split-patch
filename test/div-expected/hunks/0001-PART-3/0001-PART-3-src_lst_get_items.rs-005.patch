+                    // could change to dir-fd based POSIX functions).
+                    let path = sub_path.to_path(&mut tmp);
                     if self.ignore_path(&path) {
                         continue;
                     }
-                    let path = allocator.allocate_path(&path);
                     if metadata.is_dir() {
                         scope.spawn(move |_| {
                             let (items, errors) = self._find(
-                                path,
+                                sub_path,
                                 true,
                                 metadata,
                                 global_leaked_regions,

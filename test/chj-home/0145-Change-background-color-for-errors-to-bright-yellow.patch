From e002292745e8686c0b3de6e7941f673320237425 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sat, 25 Jun 2022 13:32:56 +0100
Subject: [PATCH 145/191] Change background color for errors to bright yellow

From dark red.

https://misc.flogisoft.com/bash/tip_colors_and_formatting
bash tip_colors_and_formatting - FLOZz' MISC.html
---
 .bashrc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.bashrc b/.bashrc
index 3c24abd..2bc0707 100644
--- a/.bashrc
+++ b/.bashrc
@@ -23,7 +23,7 @@ __ps1_show_exitcode () {
     # and for this have to use \001 \002 over \[ \] .
     # (Also see https://mywiki.wooledge.org/BashFAQ/053 .)
     if [ "$exitcode" -ne 0 ]; then
-	echo -ne '\001\033[01;41m\002'
+	echo -ne '\001\033[01;103m\002'
 	printf '%3d' "$exitcode"
 	echo -ne '\001\033[00m\002'
 	echo -n ' '
-- 
2.47.3


From 4b3fcad89017a224beff46e288add7d38a86dd75 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 26 Nov 2017 00:17:33 +0000
Subject: [PATCH 037/191] merge root's home's features

---
 .bash_profile | 3 +++
 .bashrc       | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/.bash_profile b/.bash_profile
index 1c648b2..a665dd1 100644
--- a/.bash_profile
+++ b/.bash_profile
@@ -24,6 +24,9 @@ if [ -d ~/local/bin ] ; then
     PATH=~/local/bin:"${PATH}"
 fi
 
+if [ "$UID" -eq 0 ]; then
+    PATH=/root/local/sbin:/root/sbin:"$PATH"
+fi
 
 # --- General env setup -------
 unset LESSOPEN
diff --git a/.bashrc b/.bashrc
index 735bd94..63ddcb6 100644
--- a/.bashrc
+++ b/.bashrc
@@ -141,6 +141,13 @@ settitle () {
     /opt/chj/bin/settitle "$@"
 }
 
+if [ "$UID" -eq 0 ]; then
+    tar () {
+	echo "'tar': use tar-names or tar-numbers instead" >&2
+	return 1
+    }
+fi
+
 
 # --- End -------------------------------------
 if [ -f ~/.bashrc_local ]; then
-- 
2.47.3


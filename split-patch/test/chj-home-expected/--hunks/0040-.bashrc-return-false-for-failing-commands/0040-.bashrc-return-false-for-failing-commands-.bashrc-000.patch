From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 26 Nov 2017 01:04:36 +0000
Subject: .bashrc 000: [PATCH 040/191] .bashrc: return false for failing commands

---
 .bashrc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -72,6 +72,7 @@ cdnewdir() {
         mkdir "$1" && cd "$1"
     else
         echo One argument required
+	false
     fi
 };
 mvcdnewdir() {

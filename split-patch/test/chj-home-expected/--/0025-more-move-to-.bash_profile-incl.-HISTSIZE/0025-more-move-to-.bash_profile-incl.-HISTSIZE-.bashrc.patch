From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sat, 25 Nov 2017 18:11:00 +0000
Subject: .bashrc: [PATCH 025/191] more move to .bash_profile, incl. HISTSIZE

---
 .bash_profile | 2 ++
 .bashrc       | 4 +---
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/.bashrc b/.bashrc
index 72a5111..2b1c696 100644
--- a/.bashrc
+++ b/.bashrc
@@ -119,9 +119,6 @@ cdpwd() {
 cdp() {
     cd "`pwd -P`"
 }
-export COLUMNS
-
-HISTSIZE=1500
 
 unlimit() {
     ulimit -S -v unlimited
@@ -172,3 +169,4 @@ EOF
     E users/Christian_Jaeger.md
 }
 
+

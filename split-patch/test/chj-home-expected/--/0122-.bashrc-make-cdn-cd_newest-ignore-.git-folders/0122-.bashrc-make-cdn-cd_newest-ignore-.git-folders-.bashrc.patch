From db2306aa5136704f61bb166314380ba080d8a9ae Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Fri, 3 Sep 2021 00:10:18 +0100
Subject: .bashrc: [PATCH 122/191] .bashrc: make cdn / cd_newest ignore .git folders

---
 .bashrc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.bashrc b/.bashrc
index a1a6f48..852fa12 100644
--- a/.bashrc
+++ b/.bashrc
@@ -139,7 +139,7 @@ mvcd () {
 }
 _ls_newest () {
     find "$1" -maxdepth 1 -type d -print0 | \
-	grep -zZ -v '^\.*$' | \
+	grep -P -zZ -v '^\.\.?(/\.git)?$' | \
 	xargs -0 -s 129023 -n 129023 --exit --no-run-if-empty ls -dt |
 	head -1
 }

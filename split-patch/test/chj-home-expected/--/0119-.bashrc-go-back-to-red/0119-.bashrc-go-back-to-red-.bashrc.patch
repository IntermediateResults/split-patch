From edbafb43491e3613da24b6d36981c41dc23d3206 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Wed, 23 Jun 2021 23:33:10 +0100
Subject: .bashrc: [PATCH 119/191] .bashrc: go back to red

---
 .bashrc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.bashrc b/.bashrc
index 5a761cc..53820f9 100644
--- a/.bashrc
+++ b/.bashrc
@@ -23,7 +23,7 @@ __ps1_show_exitcode () {
     # and for this have to use \001 \002 over \[ \] .
     # (Also see https://mywiki.wooledge.org/BashFAQ/053 .)
     if [ "$exitcode" -ne 0 ]; then
-	echo -ne '\001\033[01;45m\002'
+	echo -ne '\001\033[01;41m\002'
 	printf '%3d' "$exitcode"
 	echo -ne '\001\033[00m\002'
 	echo -n ' '

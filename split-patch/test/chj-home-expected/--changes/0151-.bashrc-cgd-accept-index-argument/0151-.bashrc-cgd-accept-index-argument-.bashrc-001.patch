From d6a7f736b21577f4a3164f161884b0af5ab54810 Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 24 Jul 2022 13:14:18 +0100
Subject: .bashrc 001: [PATCH 151/191] .bashrc: cgd*: accept index argument

---
 .bashrc | 61 +++++++++++++++++++++++++++++++++++++++++++++++----------
 1 file changed, 51 insertions(+), 10 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -176,4 +177,23 @@ cdnnn () {
 _cgd_ () {
-    local res=$1
-    # I forgot how to do this with builtins:
+    local gd_="$1"
+    shift
+    if [ $# = 0 ]; then
+        echo "Please give name-regex (and optionally index into result list)" >&2
+        return 1
+    fi
+    local last="${@:$#:1}"
+    local index=""
+    local args
+    declare -a args
+    if printf '%s' "$last" | egrep -q '^[0-9]+$'; then
+        index="$last"
+        args=("${@:1:$(( $# - 1 ))}")
+    else
+        args=("$@")
+    fi
+    local res
+    if ! res="$("$gd_" "${args[@]}")"; then
+        return 1
+    fi
+    # (XX do these with builtins?)
     if [ -n "$res" ]; then

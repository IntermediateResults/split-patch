From d22fea0e520e351f4bd680b42f5ae744c949bd4a Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 1 Sep 2024 05:29:55 +0200
Subject: .bashrc 000: [PATCH 179/191] .bashrc: change cdnn, cdnnn to use lastdir --depth

Also fixes a typo in cd_newest_sisterfolder?!
---
 .bashrc | 27 +++++++++++++++------------
 1 file changed, 15 insertions(+), 12 deletions(-)

diff --git a/.bashrc b/.bashrc
--- a/.bashrc
+++ b/.bashrc
@@ -139,6 +139,9 @@ mvcd () {
     fi
 }
 _ls_newest () {
-    lastdir --fullpath -a -- "$@"
+    local n
+    n="$1"
+    shift
+    lastdir --depth "$n" --fullpath -a -- "$@"
 }
 cd_newest_sisterfolder () {

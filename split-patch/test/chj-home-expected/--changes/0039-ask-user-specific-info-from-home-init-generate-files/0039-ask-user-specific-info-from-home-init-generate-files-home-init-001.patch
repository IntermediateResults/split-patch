From 47f896faa205419bee6e91c7d8d539199d825afa Mon Sep 17 00:00:00 2001
From: Christian Jaeger <ch@christianjaeger.ch>
Date: Sun, 26 Nov 2017 01:04:27 +0000
Subject: home-init 001: [PATCH 039/191] ask user-specific info from home-init, generate files

---
 .bash_profile |  7 +++---
 .gitconfig    | 20 -----------------
 home-init     | 61 +++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 60 insertions(+), 28 deletions(-)
 delete mode 100644 .gitconfig

diff --git a/home-init b/home-init
--- a/home-init
+++ b/home-init
@@ -10,2 +23,18 @@ set -euo pipefail
     fi
+else
+    cancel
+fi
+
+if [ -e .bash_profile_local ]; then
+    /opt/chj/bin/mvnumber .bash_profile_local
+fi
+cat <<'EOF' > .bash_profile_local
+export EDITOR=e
+export BROWSER="chromium-chrissbx -- --new-window"
+export EMAIL=$(cat ~/.chj-home_email)
+export LANG=en_GB.UTF-8
+EOF
+
+if [ -e .gitconfig ]; then
+    /opt/chj/bin/mvnumber .gitconfig
 fi

Subject: [PATCH 079/191] .bashrc: add rxvt-fontsize wrapper for env var
 changes

---
 .bashrc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/.bashrc b/.bashrc
index ecd2109..33f5475 100644
--- a/.bashrc
+++ b/.bashrc
@@ -218,6 +218,10 @@ lsof () {
     # -P = no port names
 }
 
+rxvt-fontsize () {
+    eval "$(/opt/chj/bin/rxvt-fontsize "$@")"
+}
+
 # Utils which might be later in PATH than system ones:
 
 ls () { /opt/chj/bin/ls --color=auto "$@"; } # XX is this still useful?
